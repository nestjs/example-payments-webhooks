NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:shop@localhost:5432/shop
# Signs the access tokens. Generate with: openssl rand -base64 32
JWT_SECRET=
# The browser origins allowed to call the API, comma-separated. None by default.
CORS_ORIGINS=

# The payment provider's API, and the key it gave you. These values point at the
# fake provider (scripts/fake-payments-provider.ts), which takes any key.
PAYMENTS_API_URL=http://localhost:4000
PAYMENTS_API_KEY=sk_test_anything
# From the provider's dashboard. For the fake provider: echo "whsec_$(openssl rand -base64 32)"
PAYMENTS_WEBHOOK_SECRET=
# "off" only in tests, which run the outbox relay themselves.
OUTBOX_RELAY=on

# NestJS Observe: `npx @nestjs/observe link` writes these. Empty, the SDK sends nothing.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
